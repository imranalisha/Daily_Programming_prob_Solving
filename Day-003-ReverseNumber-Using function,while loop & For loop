#include<iostream>
using namespace std; 

int ReverseNumber(int num){
    int rev=0;
    
    while(num!=0){
        
        int r=  num%10;
        
        rev=rev* 10+r;
        
        num=num/10;
        
        
        
    } 
    return rev;
    
}

int main(){
    
    int num;
    cout<<"enter the Number:------------->   ";
    cin>>num;
    
    int reverse= ReverseNumber(num);
    
    cout<<"The reverse of the entered number is ------------->   "<<reverse;
    
}




